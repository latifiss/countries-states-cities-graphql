# MongoDB connection string used by the API and migration script
MONGO_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/data

# Optional HTTP port (defaults to 4000)
PORT=4000

# Optional Upstash Redis REST credentials. If omitted or unavailable,
# the API continues normally using MongoDB without caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
