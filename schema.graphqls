type Country {
  id: Int!
  name: String!
  iso3: String
  iso2: String
  numeric_code: String
  phone_code: String!
  capital: String
  currency: String
  currency_name: String
  currency_symbol: String
  tld: String
  native: String
  region: String!
  subRegion: String!
  latitude: Float!
  longitude: Float!
  emoji: String
  emojiU: String
  states: [State]
  cities: [City]
}

type State {
  id: Int
  code: String
  name: String
  state_code: String
  latitude: Float
  longitude: Float
  cities: [City]
}

type City {
  id: Int
  name: String!
  latitude: Float!
  longitude: Float!
  country_name: String
}

input StringQueryOperatorInput {
  eq: String
  ne: String
  in: [String]
  nin: [String]
  regex: String
  glob: String
}

input CountryFilterInput {
  code: StringQueryOperatorInput
  currency: StringQueryOperatorInput
  region: StringQueryOperatorInput
}

input RegionFilterInput {
  code: StringQueryOperatorInput
}

input SubRegionFilterInput {
  code: StringQueryOperatorInput
}

input StateFilterInput {
  code: StringQueryOperatorInput
}

input CityFilterInput {
  state_name: StringQueryOperatorInput
}

type Query {
  Countries(filter: CountryFilterInput): [Country!]!
  Country(iso2: String!): Country!
  CountriesByRegion(region: String!): [Country]!
  CountriesBySubregion(subregion: String!): [Country]!
  States(filter: StateFilterInput): [State!]!
  StatesByCountry(country_name: String!): [State!]!
  State(name: String!): State
  Cities(filter: CityFilterInput): [City!]!
  CitiesByState(state_name: String!): [City!]!
  CitiesByCountry(country_name: String!): [City!]!
  City(name: String!): City
}
